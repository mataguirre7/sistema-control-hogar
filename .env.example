# Copiar a .env y completar. .env NUNCA se commitea.

# Credenciales de la "Cuenta de cámara" creada en la app Tapo
# (NO son las de tu cuenta TP-Link). Usá solo letras y números en la clave.
FRIGATE_TAPO_USER=CAMBIAR
FRIGATE_TAPO_PASS=CAMBIAR

# Carpeta del servidor donde se guardan grabaciones y snapshots (disco grande)
FRIGATE_MEDIA_PATH=/ruta/al/disco/frigate

# MQTT (Mosquitto con usuario/clave). Correr ./setup-mqtt.sh tras cambiarlas.
FRIGATE_MQTT_USER=frigate
FRIGATE_MQTT_PASSWORD=CAMBIAR
MQTT_HA_USER=homeassistant
MQTT_HA_PASSWORD=CAMBIAR
